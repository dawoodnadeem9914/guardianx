# =========================================================
# GuardianX — Local Environment Configuration
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.
# =========================================================

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- App ---
# Used to build absolute links in auth emails (password reset, confirmation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =========================================================
# The following are NOT required for Milestone 1 (auth + dashboard shell)
# but are reserved for upcoming milestones per the GuardianX V3.0 spec.
# Leave blank for now.
# =========================================================

# --- AI (GPT-4o mini, Vision, Whisper, TTS) ---
OPENAI_API_KEY=

# --- Google Maps ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
